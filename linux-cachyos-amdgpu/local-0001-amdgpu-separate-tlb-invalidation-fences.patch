From: Christian König <ckoenig.leichtzumerken@gmail.com>
Date: Thu, 8 Oct 2026 14:42:32 +0200
Subject: [PATCH] drm/amdgpu: fix TLB invalidation fence handling

After each unmap it might be necessary to invalidate the TLB to flush out
VM changes to the HW and make it visible to executing work.

We tracked that as part of the vm->last_update fence, but as pointed out
by David it can be that this is overwritten by PDE updates when we have a
combined unmap/map operation.

In that case userspace doesn't correctly wait for the TLB invalidation to
finish leading to all kind of problems (sq_int, page faults etc...).

Signed-off-by: Christian König <christian.koenig@amd.com>

Backport notes:
- Correct NULL-fence callbacks, immediate-update output handling and
  replaced-fence ownership.
- Retain invalidation on BO close even when no new clear is submitted.
- Join pending update and invalidation fences with upstream merge semantics.
- Preserve PRT, KFD and user-queue restore completion dependencies.
- Partial submissions not published by update helpers remain outside scope.

Source: https://lore.kernel.org/amd-gfx/20261008124232.23825-1-christian.koenig@amd.com/
---
diff --git a/drivers/gpu/drm/amd/amdgpu/amdgpu_amdkfd_gpuvm.c b/drivers/gpu/drm/amd/amdgpu/amdgpu_amdkfd_gpuvm.c
--- a/drivers/gpu/drm/amd/amdgpu/amdgpu_amdkfd_gpuvm.c
+++ b/drivers/gpu/drm/amd/amdgpu/amdgpu_amdkfd_gpuvm.c
@@ -507,7 +507,11 @@
 	if (ret)
 		return ret;
 
-	return amdgpu_sync_fence(sync, vm->last_update, GFP_KERNEL);
+	ret = amdgpu_sync_fence(sync, vm->last_update, GFP_KERNEL);
+	if (ret)
+		return ret;
+
+	return amdgpu_sync_fence(sync, vm->last_tlb_inv, GFP_KERNEL);
 }
 
 static uint64_t get_pte_flags(struct amdgpu_device *adev, struct amdgpu_vm *vm,
@@ -1288,6 +1292,8 @@
 	(void)amdgpu_vm_clear_freed(adev, vm, &bo_va->last_pt_update);
 
 	(void)amdgpu_sync_fence(sync, bo_va->last_pt_update, GFP_KERNEL);
+	if (amdgpu_sync_fence(sync, vm->last_tlb_inv, GFP_KERNEL))
+		dma_fence_wait(vm->last_tlb_inv, false);
 
 	return 0;
 }
diff --git a/drivers/gpu/drm/amd/amdgpu/amdgpu_gem.c b/drivers/gpu/drm/amd/amdgpu/amdgpu_gem.c
--- a/drivers/gpu/drm/amd/amdgpu/amdgpu_gem.c
+++ b/drivers/gpu/drm/amd/amdgpu/amdgpu_gem.c
@@ -326,7 +326,7 @@
 
 	drm_exec_init(&exec, DRM_EXEC_IGNORE_DUPLICATES, 0);
 	drm_exec_until_all_locked(&exec) {
-		r = drm_exec_prepare_obj(&exec, &bo->tbo.base, 1);
+		r = drm_exec_prepare_obj(&exec, &bo->tbo.base, 2);
 		drm_exec_retry_on_contention(&exec);
 		if (unlikely(r))
 			goto out_unlock;
@@ -350,17 +350,19 @@
 	amdgpu_vm_bo_del(adev, bo_va);
 	amdgpu_vm_bo_update_shared(bo);
 	if (!amdgpu_vm_ready(vm))
-		goto out_unlock;
+		goto out_fence;
 
 	r = amdgpu_vm_clear_freed(adev, vm, &fence);
 	if (unlikely(r < 0) && !drm_dev_is_unplugged(adev_to_drm(adev)))
 		dev_err(adev->dev, "failed to clear page "
 			"tables on GEM object close (%ld)\n", r);
-	if (r || !fence)
-		goto out_unlock;
-
-	amdgpu_bo_fence(bo, fence, true);
-	dma_fence_put(fence);
+	if (fence) {
+		amdgpu_bo_fence(bo, fence, true);
+		dma_fence_put(fence);
+	}
+out_fence:
+	/* A prior unmap can still be invalidating translations on close. */
+	amdgpu_bo_fence(bo, vm->last_tlb_inv, true);
 
 out_unlock:
 	if (r && !drm_dev_is_unplugged(adev_to_drm(adev)))
@@ -752,6 +754,31 @@
 	return r;
 }
 
+static struct dma_fence *
+amdgpu_gem_va_update_fence(struct amdgpu_vm *vm,
+			   struct amdgpu_bo_va *bo_va, uint32_t operation)
+{
+	struct dma_fence *bo_fence = NULL, *fence;
+
+	if ((operation == AMDGPU_VA_OP_MAP ||
+	     operation == AMDGPU_VA_OP_REPLACE) &&
+	    !amdgpu_vm_is_bo_always_valid(vm, bo_va->base.bo))
+		bo_fence = bo_va->last_pt_update;
+
+	/* Do not carry completed failures into subsequent updates. */
+	fence = dma_fence_unwrap_merge(vm->last_update, vm->last_tlb_inv,
+				      bo_fence);
+	if (!fence) {
+		/* Allocation failure must not drop any pending dependency. */
+		dma_fence_wait(vm->last_update, false);
+		dma_fence_wait(vm->last_tlb_inv, false);
+		if (bo_fence)
+			dma_fence_wait(bo_fence, false);
+		fence = dma_fence_get_stub();
+	}
+	return fence;
+}
+
 /**
  * amdgpu_gem_va_update_vm -update the bo_va in its VM
  *
@@ -763,8 +790,8 @@
  * Update the bo_va directly after setting its address. Errors are not
  * vital here, so they are not reported back to userspace.
  *
- * Returns resulting fence if freed BO(s) got cleared from the PT.
- * otherwise stub fence in case of error.
+ * Returns completion of pending published page-table updates and
+ * invalidation. Returns a stub if the VM is not ready.
  */
 static struct dma_fence *
 amdgpu_gem_va_update_vm(struct amdgpu_device *adev,
@@ -772,66 +799,33 @@
 			struct amdgpu_bo_va *bo_va,
 			uint32_t operation)
 {
-	struct dma_fence *fence;
 	int r = 0;
 
 	/* If the VM is not ready return only a stub. */
 	if (!amdgpu_vm_ready(vm))
 		return dma_fence_get_stub();
 
-
-	/*
-	 * First clean up any freed mappings in the VM.
-	 *
-	 * amdgpu_vm_clear_freed() may replace @fence with a new fence if it
-	 * schedules GPU work. If nothing needs clearing, @fence can remain as
-	 * the original vm->last_update.
-	 */
+	/* First clean up any freed mappings in the VM. */
 	r = amdgpu_vm_clear_freed(adev, vm, &vm->last_update);
 	if (r)
-		goto error;
+		goto out;
 
 	/* For MAP/REPLACE we also need to update the BO mappings. */
 	if (operation == AMDGPU_VA_OP_MAP ||
 	    operation == AMDGPU_VA_OP_REPLACE) {
 		r = amdgpu_vm_bo_update(adev, bo_va, false);
 		if (r)
-			goto error;
+			goto out;
 	}
 
 	/* Always update PDEs after we touched the mappings. */
 	r = amdgpu_vm_update_pdes(adev, vm, false);
-	if (r)
-		goto error;
-
-	if ((operation == AMDGPU_VA_OP_MAP ||
-	     operation == AMDGPU_VA_OP_REPLACE) &&
-	    !amdgpu_vm_is_bo_always_valid(vm, bo_va->base.bo)) {
 
-		/*
-		 * For MAP/REPLACE of non per-VM BOs we need to sync to both the
-		 * bo_va->last_pt_update and vm->last_update or otherwise we
-		 * potentially miss the PDE updates.
-		 */
-		fence = dma_fence_unwrap_merge(vm->last_update,
-					       bo_va->last_pt_update);
-		if (!fence) {
-			/* As fallback in OOM situations */
-			dma_fence_wait(vm->last_update, false);
-			dma_fence_wait(bo_va->last_pt_update, false);
-			fence = dma_fence_get_stub();
-		}
-	} else {
-		fence = dma_fence_get(vm->last_update);
-	}
-
-	return fence;
-
-error:
+out:
 	if (r && r != -ERESTARTSYS)
 		DRM_ERROR("Couldn't update BO_VA (%d)\n", r);
 
-	return dma_fence_get(vm->last_update);
+	return amdgpu_gem_va_update_fence(vm, bo_va, operation);
 }
 
 int amdgpu_gem_va_ioctl(struct drm_device *dev, void *data,
diff --git a/drivers/gpu/drm/amd/amdgpu/amdgpu_vm.c b/drivers/gpu/drm/amd/amdgpu/amdgpu_vm.c
--- a/drivers/gpu/drm/amd/amdgpu/amdgpu_vm.c
+++ b/drivers/gpu/drm/amd/amdgpu/amdgpu_vm.c
@@ -1071,21 +1071,16 @@
  */
 static void
 amdgpu_vm_tlb_flush(struct amdgpu_vm_update_params *params,
-		    struct dma_fence **fence,
+		    struct dma_fence *fence,
 		    struct amdgpu_vm_tlb_seq_struct *tlb_cb)
 {
 	struct amdgpu_vm *vm = params->vm;
 
 	tlb_cb->vm = vm;
-	if (!fence || !*fence) {
-		amdgpu_vm_tlb_seq_cb(NULL, &tlb_cb->cb);
-		return;
-	}
-
-	if (!dma_fence_add_callback(*fence, &tlb_cb->cb,
-				    amdgpu_vm_tlb_seq_cb)) {
-		dma_fence_put(vm->last_tlb_flush);
-		vm->last_tlb_flush = dma_fence_get(*fence);
+	if (fence && !dma_fence_add_callback(fence, &tlb_cb->cb,
+					      amdgpu_vm_tlb_seq_cb)) {
+		dma_fence_put(vm->last_seq_flush);
+		vm->last_seq_flush = dma_fence_get(fence);
 	} else {
 		amdgpu_vm_tlb_seq_cb(NULL, &tlb_cb->cb);
 	}
@@ -1094,12 +1089,13 @@
 	/* The check for need_tlb_fence should be dropped once we
 	 * sort out the issues with KIQ/MES TLB invalidation timeouts.
 	 */
-	if (!params->unlocked && vm->need_tlb_fence) {
-		amdgpu_vm_tlb_fence_create(params->adev, vm, fence);
+	if (fence && !params->unlocked && vm->need_tlb_fence) {
+		amdgpu_vm_tlb_fence_create(params->adev, vm, fence,
+					   &vm->last_tlb_inv);
 
 		/* Makes sure no PD/PT is freed before the flush */
-		dma_resv_add_fence(vm->root.bo->tbo.base.resv, *fence,
-				   DMA_RESV_USAGE_BOOKKEEP);
+		dma_resv_add_fence(vm->root.bo->tbo.base.resv,
+				   vm->last_tlb_inv, DMA_RESV_USAGE_BOOKKEEP);
 	}
 }
 
@@ -1248,7 +1244,7 @@
 		goto error_free;
 
 	if (params.needs_flush) {
-		amdgpu_vm_tlb_flush(&params, fence, tlb_cb);
+		amdgpu_vm_tlb_flush(&params, fence ? *fence : NULL, tlb_cb);
 		tlb_cb = NULL;
 	}
 
@@ -1532,8 +1528,13 @@
 				   struct amdgpu_bo_va_mapping *mapping,
 				   struct dma_fence *fence)
 {
-	if (mapping->flags & AMDGPU_VM_PAGE_PRT)
+	if (mapping->flags & AMDGPU_VM_PAGE_PRT) {
+		if (vm->need_tlb_fence) {
+			amdgpu_vm_prt_get(adev);
+			amdgpu_vm_add_prt_cb(adev, vm->last_tlb_inv);
+		}
 		amdgpu_vm_add_prt_cb(adev, fence);
+	}
 	kfree(mapping);
 }
 
@@ -2635,7 +2636,8 @@
 
 	vm->last_update = dma_fence_get_stub();
 	vm->last_unlocked = dma_fence_get_stub();
-	vm->last_tlb_flush = dma_fence_get_stub();
+	vm->last_seq_flush = dma_fence_get_stub();
+	vm->last_tlb_inv = dma_fence_get_stub();
 	vm->generation = amdgpu_vm_generation(adev, NULL);
 
 	mutex_init(&vm->eviction_lock);
@@ -2679,7 +2681,8 @@
 
 error_free_delayed:
 	dma_fence_put(vm->last_update);
-	dma_fence_put(vm->last_tlb_flush);
+	dma_fence_put(vm->last_seq_flush);
+	dma_fence_put(vm->last_tlb_inv);
 	dma_fence_put(vm->last_unlocked);
 	ttm_lru_bulk_move_fini(&adev->mman.bdev, &vm->lru_bulk_move);
 	amdgpu_vm_fini_entities(vm);
@@ -2782,11 +2785,11 @@
 	amdgpu_bo_reserve(root, true);
 	dma_fence_wait(vm->last_unlocked, false);
 	dma_fence_put(vm->last_unlocked);
-	dma_fence_wait(vm->last_tlb_flush, false);
+	dma_fence_wait(vm->last_seq_flush, false);
 	/* Make sure that all fence callbacks have completed */
-	dma_fence_lock_irqsave(vm->last_tlb_flush, flags);
-	dma_fence_unlock_irqrestore(vm->last_tlb_flush, flags);
-	dma_fence_put(vm->last_tlb_flush);
+	dma_fence_lock_irqsave(vm->last_seq_flush, flags);
+	dma_fence_unlock_irqrestore(vm->last_seq_flush, flags);
+	dma_fence_put(vm->last_seq_flush);
 
 	list_for_each_entry_safe(mapping, tmp, &vm->freed, list) {
 		if (mapping->flags & AMDGPU_VM_PAGE_PRT && prt_fini_needed) {
@@ -2818,6 +2821,7 @@
 	}
 
 	dma_fence_put(vm->last_update);
+	dma_fence_put(vm->last_tlb_inv);
 
 	for (i = 0; i < AMDGPU_MAX_VMHUBS; i++) {
 		amdgpu_vmid_free_reserved(adev, vm, i);
diff --git a/drivers/gpu/drm/amd/amdgpu/amdgpu_vm.h b/drivers/gpu/drm/amd/amdgpu/amdgpu_vm.h
--- a/drivers/gpu/drm/amd/amdgpu/amdgpu_vm.h
+++ b/drivers/gpu/drm/amd/amdgpu/amdgpu_vm.h
@@ -401,11 +401,12 @@
 	struct drm_sched_entity	immediate;
 	struct drm_sched_entity	delayed;
 
-	/* Last finished delayed update */
+	/* Last TLB seq/fence */
 	atomic64_t		tlb_seq;
-	struct dma_fence	*last_tlb_flush;
+	struct dma_fence	*last_seq_flush;
 	atomic64_t		kfd_last_flushed_seq;
 	uint64_t		tlb_fence_context;
+	struct dma_fence	*last_tlb_inv;
 
 	/* How many times we had to re-generate the page tables */
 	uint64_t		generation;
@@ -642,7 +643,7 @@
 	 * sure that the dma_fence structure isn't freed up.
 	 */
 	rcu_read_lock();
-	lock = dma_fence_spinlock(vm->last_tlb_flush);
+	lock = dma_fence_spinlock(vm->last_seq_flush);
 	rcu_read_unlock();
 
 	spin_lock_irqsave(lock, flags);
@@ -683,9 +684,9 @@
 				  uint32_t status,
 				  unsigned int vmhub);
 void amdgpu_vm_tlb_fence_create(struct amdgpu_device *adev,
-				 struct amdgpu_vm *vm,
-				 struct dma_fence **fence);
-
+				struct amdgpu_vm *vm,
+				struct dma_fence *dep,
+				struct dma_fence **fence);
 void amdgpu_vm_print_task_info(struct amdgpu_device *adev,
 			       struct amdgpu_task_info *task_info);
 
diff --git a/drivers/gpu/drm/amd/amdgpu/amdgpu_vm_tlb_fence.c b/drivers/gpu/drm/amd/amdgpu/amdgpu_vm_tlb_fence.c
--- a/drivers/gpu/drm/amd/amdgpu/amdgpu_vm_tlb_fence.c
+++ b/drivers/gpu/drm/amd/amdgpu/amdgpu_vm_tlb_fence.c
@@ -75,7 +75,19 @@
 	.get_timeline_name = amdgpu_tlb_fence_get_timeline_name
 };
 
-void amdgpu_vm_tlb_fence_create(struct amdgpu_device *adev, struct amdgpu_vm *vm,
+/**
+ * amdgpu_vm_tlb_fence_create - create a TLB invalidation fence
+ * @adev: the amdgpu device
+ * @vm: the vm to use
+ * @dep: the dependency to wait for
+ * @fence: the resulting fence
+ *
+ * Creates a TLB invalidation fence which signals when all the VMIDs assigned to
+ * the PASID of the VM are invalidated.
+ */
+void amdgpu_vm_tlb_fence_create(struct amdgpu_device *adev,
+				struct amdgpu_vm *vm,
+				struct dma_fence *dep,
 				struct dma_fence **fence)
 {
 	struct amdgpu_tlb_fence *f;
@@ -86,16 +98,15 @@
 		 * We can't fail since the PDEs and PTEs are already updated, so
 		 * just block for the dependency and execute the TLB flush
 		 */
-		if (*fence)
-			dma_fence_wait(*fence, false);
+		if (dep)
+			dma_fence_wait(dep, false);
 
 		amdgpu_gmc_flush_gpu_tlb_pasid(adev, vm->pasid, 2, true, 0);
-		*fence = dma_fence_get_stub();
 		return;
 	}
 
 	f->adev = adev;
-	f->dependency = *fence;
+	f->dependency = dma_fence_get(dep);
 	f->pasid = vm->pasid;
 	INIT_WORK(&f->work, amdgpu_tlb_fence_work);
 	spin_lock_init(&f->lock);
@@ -107,5 +118,6 @@
 	dma_fence_get(&f->base);
 	schedule_work(&f->work);
 
+	dma_fence_put(*fence);
 	*fence = &f->base;
 }
diff --git a/drivers/gpu/drm/amd/amdgpu/amdgpu_userq.c b/drivers/gpu/drm/amd/amdgpu/amdgpu_userq.c
--- a/drivers/gpu/drm/amd/amdgpu/amdgpu_userq.c
+++ b/drivers/gpu/drm/amd/amdgpu/amdgpu_userq.c
@@ -1184,2 +1184,3 @@
 	dma_fence_wait(vm->last_update, false);
+	dma_fence_wait(vm->last_tlb_inv, false);
 
