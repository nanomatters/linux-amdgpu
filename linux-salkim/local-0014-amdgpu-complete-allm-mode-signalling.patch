From: Tomasz Pakuła <tomasz.pakula.oficjalny@gmail.com>
Subject: [PATCH] drm/amd/display: Trigger ALLM if it's available

Port the Game-content trigger and HDMI-VIC handling from the v4 HDMI
Gaming Features series to the existing automatic ALLM implementation.
Preserve variable and fixed VRR triggers and initialize Game-content
signalling when the stream is created.

When HF-VSIF replaces the legacy HDMI VSIF, translate HDMI VIC 1-4 into
the corresponding AVI CTA VIC, including packets with the ALLM bit clear.
Identify HF-VSIF from the VSP packet already carried by stream updates,
rather than adding another copy of its state. DC rebuilds AVI after
copying a VSP update, so both packets stay consistent.

The optional ALLM property API is not imported: its default-off policy
would disable the existing automatic behavior until userspace opts in.

Link: https://www.mail-archive.com/amd-gfx@lists.freedesktop.org/msg137164.html
Link: https://www.mail-archive.com/amd-gfx@lists.freedesktop.org/msg137178.html
---
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
@@ -1599,8 +1599,12 @@
 	update_stream_signal(stream, sink);
 
 	if (stream->signal == SIGNAL_TYPE_HDMI_TYPE_A ||
-	    stream->signal == SIGNAL_TYPE_HDMI_FRL)
-		mod_build_hf_vsif_infopacket(stream, &stream->vsp_infopacket, false, false);
+	    stream->signal == SIGNAL_TYPE_HDMI_FRL) {
+		bool allm = connector->display_info.hdmi.allm &&
+			stream->content_type == DISPLAY_CONTENT_TYPE_GAME;
+
+		mod_build_hf_vsif_infopacket(stream, &stream->vsp_infopacket, allm, allm);
+	}
 
 	if (stream->signal == SIGNAL_TYPE_DISPLAY_PORT ||
 	    stream->signal == SIGNAL_TYPE_DISPLAY_PORT_MST ||
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_freesync.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_freesync.c
@@ -279,9 +279,7 @@
 	new_stream->allow_freesync = mod_freesync_get_freesync_enabled(&vrr_params);
 
 	/*
-	 * HDMI ALLM: when Gaming-VRR is active (VRR_EN=1) and the sink
-	 * advertises ALLM in the SCDS, the Source shall transmit the HF-VSIF
-	 * with ALLM_Mode=1 (HDMI 2.1 Section 7.6.6).
+	 * Trigger ALLM for active VRR or Game content when the sink supports it.
 	 */
 	if (new_stream->signal == SIGNAL_TYPE_HDMI_TYPE_A ||
 	    new_stream->signal == SIGNAL_TYPE_HDMI_FRL) {
@@ -289,7 +287,8 @@
 		bool sink_allm = aconn && aconn->base.display_info.hdmi.allm;
 		bool allm = sink_allm &&
 			(vrr_params.state == VRR_STATE_ACTIVE_VARIABLE ||
-			 vrr_params.state == VRR_STATE_ACTIVE_FIXED);
+			 vrr_params.state == VRR_STATE_ACTIVE_FIXED ||
+			 new_stream->content_type == DISPLAY_CONTENT_TYPE_GAME);
 		bool allm_changed;
 
 		mod_build_hf_vsif_infopacket(new_stream, &vsp_infopacket, allm, allm);
--- a/drivers/gpu/drm/amd/display/dc/core/dc_resource.c
+++ b/drivers/gpu/drm/amd/display/dc/core/dc_resource.c
@@ -4882,6 +4882,11 @@
 	unsigned int rid = pipe_ctx->stream->timing.rid;
 	unsigned int fr_ind = pipe_ctx->stream->timing.fr_index;
 	enum dc_timing_3d_format format;
+	const struct dc_info_packet *vsp = &stream->vsp_infopacket;
+	bool hf_vsif = vsp->valid &&
+		vsp->hb0 == DC_HDMI_INFOFRAME_TYPE_VENDOR && vsp->hb2 >= 5 &&
+		vsp->sb[1] == 0xd8 && vsp->sb[2] == 0x5d &&
+		vsp->sb[3] == 0xc4;
 
 	if (stream->avi_infopacket.valid) {
 		*info_packet = stream->avi_infopacket;
@@ -5037,8 +5042,8 @@
 		vic = 0;
 	format = stream->timing.timing_3d_format;
 	/*todo, add 3DStereo support*/
-	if (format != TIMING_3D_FORMAT_NONE) {
-		// Based on HDMI specs hdmi vic needs to be converted to cea vic when 3D is enabled
+	if (format != TIMING_3D_FORMAT_NONE || hf_vsif) {
+		/* HF-VSIF replaces H14b-VSIF, so signal legacy modes through AVI. */
 		switch (pipe_ctx->stream->timing.hdmi_vic) {
 		case 1:
 			vic = 95;
