From: Tomasz Pakuła <tomasz.pakula.oficjalny@gmail.com>
Subject: [PATCH] drm/amd/display: Enable HDMI VRR over PCON

Not all TVs support FreeSync and many TVs suffer from VRR flickering
while FreeSync is activated. Prefer HDMI VRR over FreeSync on compatible
DP-to-HDMI converters; let the converter generate HDMI VRR metadata.

Give eligible converters their own capability path and add the tested
Chrontel CH7218 ID. Preserve the existing whitelist and DPCD capability
checks, and retain the old DP path for unlisted adapters. For VRRmax=0,
use the AMD VSDB upper bound or highest-refresh preferred timing
rather than reporting 1023 Hz. The native HDMI path instead tries the
EDID monitor-range maximum before the preferred timing.

Backport of v4 patches 08/27, 11/27, 14/27 and 15/27 to the split driver.
The adaptive-sync enum and helper names remain unchanged.
Link: https://www.mail-archive.com/dri-devel@lists.freedesktop.org/msg589349.html
Link: https://www.mail-archive.com/dri-devel@lists.freedesktop.org/msg589351.html
Link: https://www.mail-archive.com/dri-devel@lists.freedesktop.org/msg589355.html
Link: https://www.mail-archive.com/dri-devel@lists.freedesktop.org/msg589356.html

---
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
@@ -3930,13 +3930,18 @@
 	/* FIXME: Get rid of drm_edid_raw() */
 	edid = drm_edid_raw(drm_edid);
 
-	/* Some eDP panels only have the refresh rate range info in DisplayID */
-	if ((connector->display_info.monitor_range.min_vfreq == 0 ||
-	     connector->display_info.monitor_range.max_vfreq == 0))
-		parse_edid_displayid_vrr(connector, edid);
-
-	if (edid && (sink->sink_signal == SIGNAL_TYPE_DISPLAY_PORT ||
-		     sink->sink_signal == SIGNAL_TYPE_EDP)) {
+	if (amdgpu_dm_connector->dc_link)
+		as_type = dm_get_adaptive_sync_support_type(amdgpu_dm_connector->dc_link);
+
+	/* Keep unlisted converters on their existing DP capability path. */
+	if (edid && as_type != FREESYNC_TYPE_PCON_IN_WHITELIST &&
+	    (sink->sink_signal == SIGNAL_TYPE_DISPLAY_PORT ||
+	     sink->sink_signal == SIGNAL_TYPE_EDP)) {
+		/* Some eDP panels only have the refresh rate range info in DisplayID. */
+		if (!connector->display_info.monitor_range.min_vfreq ||
+		    !connector->display_info.monitor_range.max_vfreq)
+			parse_edid_displayid_vrr(connector, edid);
+
 		/* Some DP monitors expose their refresh range only in the CEA AMD VSDB. */
 		if (parse_hdmi_amd_vsdb(amdgpu_dm_connector, edid, &vsdb_info) >= 0 &&
 		    vsdb_info.freesync_supported && vsdb_info.min_refresh_rate_hz &&
@@ -4040,28 +4045,40 @@
 		}
 	}
 
-	if (amdgpu_dm_connector->dc_link)
-		as_type = dm_get_adaptive_sync_support_type(amdgpu_dm_connector->dc_link);
-
 	if (as_type == FREESYNC_TYPE_PCON_IN_WHITELIST) {
-		i = parse_hdmi_amd_vsdb(amdgpu_dm_connector, edid, &vsdb_info);
-		if (i >= 0) {
+		const struct drm_hdmi_vrr_cap *vrr_cap = &connector->display_info.hdmi.vrr_cap;
+
+		parse_hdmi_amd_vsdb(amdgpu_dm_connector, edid, &vsdb_info);
+		memset(&amdgpu_dm_connector->vsdb_info, 0,
+		       sizeof(amdgpu_dm_connector->vsdb_info));
+		amdgpu_dm_connector->min_vfreq = 0;
+		amdgpu_dm_connector->max_vfreq = 0;
+
+		/* Prefer HDMI VRR; the converter generates the HDMI metadata. */
+		if (vrr_cap->supported && vrr_cap->vrr_min) {
+			amdgpu_dm_connector->min_vfreq = vrr_cap->vrr_min;
+			amdgpu_dm_connector->max_vfreq = vrr_cap->vrr_max ?
+				vrr_cap->vrr_max : vsdb_info.max_refresh_rate_hz;
+			if (!amdgpu_dm_connector->max_vfreq) {
+				struct drm_display_mode *brr_mode =
+					amdgpu_dm_get_highest_refresh_rate_mode(amdgpu_dm_connector, true);
+
+				if (brr_mode)
+					amdgpu_dm_connector->max_vfreq = drm_mode_vrefresh(brr_mode);
+			}
+		} else if (vsdb_info.freesync_supported && vsdb_info.amd_vsdb_version > 0) {
 			amdgpu_dm_connector->vsdb_info = vsdb_info;
 			sink->edid_caps.freesync_vcp_code = vsdb_info.freesync_mccs_vcp_code;
-
-			if (vsdb_info.freesync_supported && vsdb_info.amd_vsdb_version > 0) {
-				amdgpu_dm_connector->pack_sdp_v1_3 = true;
-				amdgpu_dm_connector->as_type = as_type;
-
-				amdgpu_dm_connector->min_vfreq = vsdb_info.min_refresh_rate_hz;
-				amdgpu_dm_connector->max_vfreq = vsdb_info.max_refresh_rate_hz;
-				if (amdgpu_dm_connector->max_vfreq - amdgpu_dm_connector->min_vfreq > 10)
-					freesync_capable = true;
-
-				connector->display_info.monitor_range.min_vfreq = vsdb_info.min_refresh_rate_hz;
-				connector->display_info.monitor_range.max_vfreq = vsdb_info.max_refresh_rate_hz;
-			}
-		}
+			amdgpu_dm_connector->min_vfreq = vsdb_info.min_refresh_rate_hz;
+			amdgpu_dm_connector->max_vfreq = vsdb_info.max_refresh_rate_hz;
+		}
+
+		amdgpu_dm_connector->pack_sdp_v1_3 = true;
+		amdgpu_dm_connector->as_type = as_type;
+		freesync_capable = amdgpu_dm_connector->max_vfreq -
+			amdgpu_dm_connector->min_vfreq > 10;
+		connector->display_info.monitor_range.min_vfreq = amdgpu_dm_connector->min_vfreq;
+		connector->display_info.monitor_range.max_vfreq = amdgpu_dm_connector->max_vfreq;
 	}
 
 	/* Handle MCCS */
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_helpers.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_helpers.c
@@ -1650,6 +1650,7 @@
 	DP_BRANCH_DEVICE_ID_90CC24,
 	DP_BRANCH_DEVICE_ID_001CF8,
 	DP_BRANCH_DEVICE_ID_001FF2,
+	DP_BRANCH_DEVICE_ID_2B02F0,
 };
 EXPORT_IF_KUNIT(dm_freesync_pcon_whitelist);
 
--- a/drivers/gpu/drm/amd/display/include/ddc_service_types.h
+++ b/drivers/gpu/drm/amd/display/include/ddc_service_types.h
@@ -36,6 +36,7 @@
 #define DP_BRANCH_DEVICE_ID_006037 0x006037
 #define DP_BRANCH_DEVICE_ID_001CF8 0x001CF8
 #define DP_BRANCH_DEVICE_ID_0060AD 0x0060AD
+#define DP_BRANCH_DEVICE_ID_2B02F0 0x2B02F0 /* Chrontel CH7218 */
 #define DP_BRANCH_DEVICE_ID_001FF2 0x001FF2
 #define DP_BRANCH_HW_REV_10 0x10
 #define DP_BRANCH_HW_REV_20 0x20
