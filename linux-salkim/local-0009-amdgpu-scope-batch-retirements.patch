Subject: [PATCH] drm/amdgpu: Scope sparse batch retirement records

Allow preallocated replacements to collect retired mappings per batch.
Keep v1 retirement order and synchronization unchanged.

---
diff --git a/drivers/gpu/drm/amd/amdgpu/amdgpu_gem.c b/drivers/gpu/drm/amd/amdgpu/amdgpu_gem.c
--- a/drivers/gpu/drm/amd/amdgpu/amdgpu_gem.c
+++ b/drivers/gpu/drm/amd/amdgpu/amdgpu_gem.c
@@ -1054,6 +1054,7 @@
 	struct amdgpu_bo_va *bo_va;
 	struct drm_exec exec;
 	DEFINE_XARRAY(bos);
+	LIST_HEAD(freed);
 	u64 end, vm_size = adev->vm_manager.max_pfn * AMDGPU_GPU_PAGE_SIZE;
 	u32 i, j;
 	int r;
@@ -1148,8 +1149,10 @@
 	for (i = 0; i < args->count; ++i)
 		amdgpu_vm_bo_replace_map_prealloc(adev, entries[i].bo_va,
 			ops[i].va_address, ops[i].offset_in_bo, ops[i].map_size,
-			ops[i].flags, entries[i].maps);
+			ops[i].flags, entries[i].maps, &freed);
 	args->applied = args->count;
+	/* Version 1 retires batch and legacy unmaps with the same dependencies. */
+	list_splice_init(&freed, &vm->freed);
 
 	/* Like GEM_VA, leave updates pending until CS validates the VM. */
 	if (!amdgpu_vm_ready(vm)) {
diff --git a/drivers/gpu/drm/amd/amdgpu/amdgpu_vm.c b/drivers/gpu/drm/amd/amdgpu/amdgpu_vm.c
--- a/drivers/gpu/drm/amd/amdgpu/amdgpu_vm.c
+++ b/drivers/gpu/drm/amd/amdgpu/amdgpu_vm.c
@@ -2244,6 +2244,7 @@
  * @size: size of the range
  * @before: prepared record for the surviving prefix
  * @after: prepared record for the surviving suffix
+ * @freed: destination for mappings requiring GPU retirement
  *
  * Remove all mappings in a range, split them as appropriate.
  *
@@ -2252,7 +2253,8 @@
 static void amdgpu_vm_bo_clear_mappings_prealloc(struct amdgpu_device *adev,
 				struct amdgpu_vm *vm, uint64_t saddr, uint64_t size,
 				struct amdgpu_bo_va_mapping *before,
-				struct amdgpu_bo_va_mapping *after)
+				struct amdgpu_bo_va_mapping *after,
+				struct list_head *freed)
 {
 	struct amdgpu_bo_va_mapping *tmp, *next;
 	LIST_HEAD(removed);
@@ -2305,7 +2307,7 @@
 		    tmp->last = eaddr;
 
 		tmp->bo_va = NULL;
-		list_add(&tmp->list, &vm->freed);
+		list_add(&tmp->list, freed);
 		trace_amdgpu_vm_bo_unmap(NULL, tmp);
 	}
 
@@ -2356,19 +2358,21 @@
 		kfree(before);
 		return -ENOMEM;
 	}
-	amdgpu_vm_bo_clear_mappings_prealloc(adev, vm, saddr, size, before, after);
+	amdgpu_vm_bo_clear_mappings_prealloc(adev, vm, saddr, size, before, after,
+					   &vm->freed);
 	return 0;
 }
 
 /* Parameters are validated and all three records allocated before mutation. */
 void amdgpu_vm_bo_replace_map_prealloc(struct amdgpu_device *adev,
 		struct amdgpu_bo_va *bo_va, uint64_t saddr, uint64_t offset,
-		uint64_t size, uint32_t flags, struct amdgpu_bo_va_mapping **maps)
+		uint64_t size, uint32_t flags, struct amdgpu_bo_va_mapping **maps,
+		struct list_head *freed)
 {
 	struct amdgpu_bo_va_mapping *mapping = maps[0];
 
 	amdgpu_vm_bo_clear_mappings_prealloc(adev, bo_va->base.vm, saddr, size,
-					   maps[1], maps[2]);
+					   maps[1], maps[2], freed);
 	mapping->start = saddr / AMDGPU_GPU_PAGE_SIZE;
 	mapping->last = mapping->start + (size - 1) / AMDGPU_GPU_PAGE_SIZE;
 	mapping->offset = offset;
diff --git a/drivers/gpu/drm/amd/amdgpu/amdgpu_vm.h b/drivers/gpu/drm/amd/amdgpu/amdgpu_vm.h
--- a/drivers/gpu/drm/amd/amdgpu/amdgpu_vm.h
+++ b/drivers/gpu/drm/amd/amdgpu/amdgpu_vm.h
@@ -566,7 +566,8 @@
 			       uint64_t addr, uint64_t offset, uint64_t size);
 void amdgpu_vm_bo_replace_map_prealloc(struct amdgpu_device *adev,
 		struct amdgpu_bo_va *bo_va, uint64_t addr, uint64_t offset,
-		uint64_t size, uint32_t flags, struct amdgpu_bo_va_mapping **maps);
+		uint64_t size, uint32_t flags, struct amdgpu_bo_va_mapping **maps,
+		struct list_head *freed);
 int amdgpu_vm_bo_unmap(struct amdgpu_device *adev,
 		       struct amdgpu_bo_va *bo_va,
 		       uint64_t addr);
