From: Tomasz Pakuła <tomasz.pakula.oficjalny@gmail.com>
Subject: [PATCH] drm/amd/display: Check for VRR range in CEA AMD vsdb

Some monitors only expose GTF ranges (or others, without Range Limits
Only flag). This breaks VRR even though they have explicit FreeSync
support.

For DP and eDP connections, check for VRR ranges provided in AMD vendor-
specific data block if VRR range wasn't detected. Also retain the series'
range-extension policy: preserve a raised lower boundary while LFC works.
Ignore zero or reversed AMD ranges when extending an existing range.

Backport of v4 patches 06/27 and 07/27 to amdgpu_dm_connector.c.
Link: https://www.mail-archive.com/dri-devel@lists.freedesktop.org/msg589346.html
Link: https://www.mail-archive.com/dri-devel@lists.freedesktop.org/msg589347.html

---
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
@@ -3842,6 +3842,27 @@
 }
 EXPORT_IF_KUNIT(parse_hdmi_amd_vsdb);
 
+static void extend_range_from_vsdb(struct drm_display_info *display,
+				  const struct amdgpu_hdmi_vsdb_info *vsdb)
+{
+	u16 vrr_min = display->monitor_range.min_vfreq;
+	u16 vrr_max = display->monitor_range.max_vfreq;
+
+	/* Always extend upper limit. */
+	if (vsdb->max_refresh_rate_hz > vrr_max)
+		vrr_max = vsdb->max_refresh_rate_hz;
+
+	/*
+	 * Some manufacturers raise the monitor-range minimum to avoid blanking,
+	 * without updating the AMD VSDB. Keep that limit if it still allows LFC.
+	 */
+	if (vsdb->min_refresh_rate_hz < vrr_min && vrr_min * 2 >= vrr_max)
+		vrr_min = vsdb->min_refresh_rate_hz;
+
+	display->monitor_range.min_vfreq = vrr_min;
+	display->monitor_range.max_vfreq = vrr_max;
+}
+
 /**
  * amdgpu_dm_update_freesync_caps - Update Freesync capabilities
  *
@@ -3916,6 +3937,20 @@
 
 	if (edid && (sink->sink_signal == SIGNAL_TYPE_DISPLAY_PORT ||
 		     sink->sink_signal == SIGNAL_TYPE_EDP)) {
+		/* Some DP monitors expose their refresh range only in the CEA AMD VSDB. */
+		if (parse_hdmi_amd_vsdb(amdgpu_dm_connector, edid, &vsdb_info) >= 0 &&
+		    vsdb_info.freesync_supported && vsdb_info.min_refresh_rate_hz &&
+		    vsdb_info.max_refresh_rate_hz > vsdb_info.min_refresh_rate_hz) {
+			if (!connector->display_info.monitor_range.min_vfreq ||
+			    !connector->display_info.monitor_range.max_vfreq) {
+				connector->display_info.monitor_range.min_vfreq =
+					vsdb_info.min_refresh_rate_hz;
+				connector->display_info.monitor_range.max_vfreq =
+					vsdb_info.max_refresh_rate_hz;
+			}
+			extend_range_from_vsdb(&connector->display_info, &vsdb_info);
+		}
+
 		if (amdgpu_dm_connector->dc_link &&
 		    amdgpu_dm_connector->dc_link->dpcd_caps.allow_invalid_MSA_timing_param) {
 			amdgpu_dm_connector->min_vfreq = connector->display_info.monitor_range.min_vfreq;

